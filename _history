change(LedSpriteProperty.Y, 1)\nbasic.forever(on_forever)\n"}]},{"timestamp":1791295320716,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":880,"length1":0,"diffs":[[1,"            music.playTone(523, 50)\n            // Accélère le jeu (vitesse max : 150 ms)\n            delai = Math.max(150, delai - 20)\n            // Nouveau bloc en haut\n            bloc.set(LedSpriteProperty.Y, 0)\n            bloc.set(LedSpriteProperty.X, randint(0, 4))\n"]]}]}]},{"timestamp":1791300296963,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":509,"length1":7847,"diffs":[[1,"Évitez le bloc qui tombe. Plus vous avancez, plus ça va vite !</comment><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">500</field></shadow></value><next><block type=\"device_print_message\"><comment pinned=\"false\" h=\"80\" w=\"160\">Écran de démarrage</comment><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">GO!</field></shadow></value><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">300</field></shadow></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"Uy!3K^,4e%,af;}^{XVf\">joueur</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"game_create_sprite\"><value name=\"x\"><shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow></value><value name=\"y\"><shadow type=\"math_number\"><field name=\"NUM\">4</field></shadow></value></block></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"echy1!iK(R2AsYXV=LQe\">bloc</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"game_create_sprite\"><value name=\"x\"><block type=\"device_random\"><value name=\"min\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><value name=\"limit\"><shadow type=\"math_nu