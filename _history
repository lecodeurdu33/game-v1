ite_change_xy\"><field name=\"property\">LedSpriteProperty.Y</field><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"echy1!iK(R2AsYXV=LQe\">bloc</field></block></value><value name=\"value\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value></block></statement></block></next></block></statement></block></xml>","main.ts":"","README.md":"","main.py":"# ESQUIVE - jeu pour micro:bit (MakeCode Python)\n# A = aller à gauche, B = aller à droite\n# Évitez le bloc qui tombe. Plus vous avancez, plus ça va vite !\n\ndelai = 500\njoueur: game.LedSprite = None\nbloc: game.LedSprite = None\n\ndef on_button_pressed_a():\n    if joueur:\n        joueur.change(LedSpriteProperty.X, -1)\ninput.on_button_pressed(Button.A, on_button_pressed_a)\n\ndef on_button_pressed_b():\n    if joueur:\n        joueur.change(LedSpriteProperty.X, 1)\ninput.on_button_pressed(Button.B, on_button_pressed_b)\n\n# Écran de démarrage\nbasic.show_string(\"GO!\")\nbasic.pause(300)\n\njoueur = game.create_sprite(2, 4)\nbloc = game.create_sprite(randint(0, 4), 0)\ngame.set_score(0)\n\ndef on_forever():\n    global delai\n    basic.pause(delai)\n    if bloc.get(LedSpriteProperty.Y) == 4:\n        # Le bloc est en bas : collision ou esquive réussie ?\n        if bloc.is_touching(joueur):\n            game.game_over()\n        else:\n            game.add_score(1)\n            music.play_tone(523, 50)\n            # Accélère le jeu (vitesse max : 150 ms)\n            delai = max(150, delai - 20)\n            # Nouveau bloc en haut\n            bloc.set(LedSpriteProperty.Y, 0)\n            bloc.set(LedSpriteProperty.X, randint(0, 4))\n    else:\n        bloc.change(LedSpriteProperty.Y, 1)\nbasic.forever(on_forever)\n","pxt.json":"{\n    \"name\": \"game v1.5\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.t